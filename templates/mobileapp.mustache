{{!
    @template filter_tabs/mobileapp

    Template to display tabs using ionic.
}}
<div id="filter-tabs-tabgroup-{{tabgroupcounter}}" class="filter-tabs-mobileapp">
    <ion-segment scrollable="true">
        {{#tabs}}
        <ion-segment-button 
            value="filter-tabs-tab-{{tabgroupcounter}}-{{get_key}}" 
            content-id="filter-tabs-content-{{tabgroupcounter}}-{{get_key}}">
            <ion-label>{{{get_title}}}</ion-label>
        </ion-segment-button>
        {{/tabs}}
    </ion-segment>

    <ion-segment-view>
        {{#tabs}}
        <ion-segment-content id="filter-tabs-content-{{tabgroupcounter}}-{{get_key}}">
            <div class="ion-padding">
                {{{get_content}}}
            </div>
        </ion-segment-content>
        {{/tabs}}
    </ion-segment-view>
</div>
